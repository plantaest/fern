{
  "name": "fern",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @taxonlabs/fern build && pnpm --filter fern-docs dev",
    "build": "pnpm --filter @taxonlabs/fern build && pnpm --filter fern-docs build",
    "typecheck": "pnpm --filter @taxonlabs/fern build && pnpm -r typecheck",
    "test": "pnpm --filter @taxonlabs/fern build && pnpm --filter @taxonlabs/fern test && pnpm --filter fern-docs test",
    "check": "biome check --error-on-warnings . && prettier --check \"**/*.{md,mdx}\"",
    "format": "biome check --write . && prettier --write \"**/*.{md,mdx}\"",
    "pack:check": "pnpm --filter @taxonlabs/fern build && node scripts/check-package.mjs",
    "release:check": "pnpm --filter @taxonlabs/fern build && node scripts/check-package.mjs --strict-peers"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/compiler": "2.0.0-rc.21",
    "@solidjs/babel-plugin": "2.0.0-rc.21",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "@biomejs/biome": "2.6.6",
    "prettier": "3.9.10"
  },
  "pnpm": {
    "overrides": {
      "solid-js": "2.0.0-rc.21",
      "@solidjs/web": "2.0.0-rc.21",
      "@solidjs/signals": "2.0.0-rc.21",
      "@solidjs/compiler": "2.0.0-rc.21",
      "@solidjs/babel-plugin": "2.0.0-rc.21"
    }
  }
}
