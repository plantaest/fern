{
  "name": "@taxonlabs/fern",
  "version": "0.1.0-alpha.0",
  "description": "A Wikimedia-first design system for Solid applications.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/source/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/index.js"
    },
    "./aspect-ratio": {
      "types": "./dist/source/components/aspect-ratio/aspect-ratio.d.ts",
      "solid": "./dist/source/components/aspect-ratio/aspect-ratio.jsx",
      "default": "./dist/aspect-ratio.js"
    },
    "./button": {
      "types": "./dist/source/components/button/button.d.ts",
      "solid": "./dist/source/components/button/button.jsx",
      "default": "./dist/button.js"
    },
    "./button-group": {
      "types": "./dist/source/components/button-group/button-group.d.ts",
      "solid": "./dist/source/components/button-group/button-group.jsx",
      "default": "./dist/button-group.js"
    },
    "./collapsible": {
      "types": "./dist/source/components/collapsible/collapsible.d.ts",
      "solid": "./dist/source/components/collapsible/collapsible.jsx",
      "default": "./dist/collapsible.js"
    },
    "./icon": {
      "types": "./dist/source/components/icon/icon.d.ts",
      "solid": "./dist/source/components/icon/icon.jsx",
      "default": "./dist/icon.js"
    },
    "./message": {
      "types": "./dist/source/components/message/message.d.ts",
      "solid": "./dist/source/components/message/message.jsx",
      "default": "./dist/message.js"
    },
    "./separator": {
      "types": "./dist/source/components/separator/separator.d.ts",
      "solid": "./dist/source/components/separator/separator.jsx",
      "default": "./dist/separator.js"
    },
    "./skeleton": {
      "types": "./dist/source/components/skeleton/skeleton.d.ts",
      "solid": "./dist/source/components/skeleton/skeleton.jsx",
      "default": "./dist/skeleton.js"
    },
    "./toggle-button": {
      "types": "./dist/source/components/toggle-button/toggle-button.d.ts",
      "solid": "./dist/source/components/toggle-button/toggle-button.jsx",
      "default": "./dist/toggle-button.js"
    },
    "./toggle-button-group": {
      "types": "./dist/source/components/toggle-button-group/toggle-button-group.d.ts",
      "solid": "./dist/source/components/toggle-button-group/toggle-button-group.jsx",
      "default": "./dist/toggle-button-group.js"
    },
    "./styles.css": "./dist/styles.css",
    "./colors.css": "./dist/colors.css",
    "./colors.json": "./dist/colors.json",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "colors": "node scripts/colors.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm colors && node --test tests/tokens.test.mjs && vitest run"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.23",
    "solid-js": "2.0.0-rc.23"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@wikimedia/codex-icons": "2.8.0",
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.23",
    "@wikimedia/codex-design-tokens": "2.8.0",
    "jsdom": "^31.0.1",
    "solid-js": "2.0.0-rc.23",
    "tailwindcss": "4.3.5",
    "vitest": "^5.1.0"
  }
}
